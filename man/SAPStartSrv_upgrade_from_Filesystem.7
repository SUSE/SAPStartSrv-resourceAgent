.RE
.PP
Names of SAP instance profiles
.PP
.RS 2
node1:~ # crm configure show type:primitive | grep "InstanceName="
.br
params InstanceName=EN2_ASCS00_node12as \\
.br
 START_PROFILE="/sapmnt/EN2/profile/EN2_ASCS00_node12as" \\
.br
 AUTOMATIC_RECOVER=False \\
.br
params InstanceName=EN2_ERS10_node12er \\
.br
 START_PROFILE="/sapmnt/EN2/profile/EN2_ERS10_node12er" \\
.br
 AUTOMATIC_RECOVER=False IS_ERS=True \\
.RE
.PP
Names of Filesystem resources and resource groups
.PP
.RS 2
node1:~ # crm configure show type:primitive | grep "primitive.*Filesystem"
.br
primitive rsc_fs_EN2_ASCS00 Filesystem \\
.br
primitive rsc_fs_EN2_ERS10 Filesystem \\
.PP
node1:~ # crm configure show type:group | grep group
.br
group grp_EN2_ASCS00 rsc_vip_EN2_ASCS00 \\
.br
