.\" Version: 1.2
.\"
.TH SAPStartSrv-helper 8 "16 Aug 2026" "" "SAPStartSrv"
.\"
.SH NAME
.\"
SAPStartSrv-helper \- Helper for SAPStartSrv-alert-timeout.
.PP
.\"
.SH DESCRIPTION
.\"
SAPStartSrv-helper is called by SAPStartSrv-alert-timeout.
.\" TODO
See also manual page SAPStartSrv-alert-timeout(8).
.PP
.\"
.SH SYNTAX
.\"
\fBSAPStartSrv-helper\fR \fICMD\fP \fIINSTANCENAME\fP [ \fISID\fR [ \fIINO\fR ]]
.PP
\fBCMD\fR: [ all | log | log+stack | log+stacktree | none | stack | stacktree ]
.br
Internal command to call.
.RS 2
\fBall\fR - run all implemented commands
.br
\fBlog\fR - write OS status into logs, see manual pages lsoflog(8), meminfolog(8),
psauxlog(8), netstatlog(8), vmstatlog(8), dstatelog(8)
.br
\fBlog+stack\fR - write OS status plus sapstartsrv stack trace
.br
\fBlog+stacktree\fR - write OS status plus sapstartsrv, and its child processes, stack trace
.br
\fBnone\fR - run no implemented command
.br
\fBstack\fR - write sapstartsrv stack trace, see sapstack -help 
.br
\fBstacktree\fR - write sapstartsrv, and its child processes, stack trace
.RE
.br
Required, default "log".
.PP
\fBINSTANCENAME\fR: Full qualified name of the instance, see manual page ocf_heartbeat_SAPInstance(7).
.br
Required, no default, example "P22_SCS11_p22scs".
.PP
\fBSID\fR: System Identifier, ignored.
.PP
\fBINO\fR: Instance number, ignored.
.PP
.\"
.SH RETURN CODES
.\"
.B 0
Successful program execution.
.br
.B >0
Usage, syntax or execution errors.
.br
.B >126
Called command timed out.
.br
In addition log entries are written, which can be scanned by using a pattern
like "SAPStartSrv-helper".
.\" TODO 2>&1 output to calling SAPStartSrv-alert-timeout
.PP
.\"
.SH EXAMPLES
.\"
\fB*\fR Showing alert agent helper messages.
.PP
.RS 2
# grep SAPStartSrv-helper /var/log/messages
.RE
.PP
\fB*\fR Example for sudo permissions in /etc/sudoers.d/SAPStartSrv .
.PP
See also manual pages sudoers(5) and SAPStartSrv-alert-agent(8).
.PP
.RS 2
# SAPStartSrv-alert-timeout needs
.br
hacluster ALL=(ALL) NOPASSWD: /usr/bin/SAPStartSrv-helper *
.RE
.PP
\fB*\fR Configure supportconfig plugins for collecting alert logs.
.PP
See also manual page supportconfig_plugins(5).
.PP
.RS 2
# vi /etc/ClusterTools2/supportconfig_plugins
.br
 ...
.br
cat_psauxlog
.br
cat_meminfolog
.br
cat_vmstatlog
.br
cat_lsoflog
.br
cat_netstatlog
.br
cat_cpustatelog
.br
cat_dstatelog
.br
cat_sapstacklog
.br
:wq
.RE
.PP
\fB*\fR Testing the alert agent helper.
.PP
Command is "log", instance name is "P22_ERS11_p22ers".
.PP
.RS 2
# SAPStartSrv-helper log P22_ERS11_p22ers
.br
# grep /usr/sap/.*/ERS11/ /var/log/lsof.log
.RE
.PP
.\"
.SH FILES
.TP
/usr/bin/SAPStartSrv-alert-timeout
the alert agent
.TP
/usr/bin/SAPStartSrv-helper
the default agent helper
.TP
/etc/sudoers.d/
directory for sudoers config files
.TP
/etc/ClusterTools2/supportconfig_plugins
the supportconfig plugin configuration file
.TP
/sapmnt/$SID/exe/uc/linux$HOSTTYPE/sapstack
default path to sapstack
.TP
/var/log/
directory for OS statuts logfiles psaux.log, meminfo.log, lsof.log,
cpustate.log, dstate.log, vmstat.log, netstat.log
.TP
/var/log/sapstack.log
sapstartsrv stack trace
.PP
.\"
.SH REQUIREMENTS
.\"
See REQUIREMENTS section of SAPStartSrv-alert-timeout(8).
.PP
